# --- App ---
ENV=development
DEBUG=true

# --- Database ---
POSTGRES_USER=yetgil
POSTGRES_PASSWORD=changeme
POSTGRES_DB=yetgil
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://yetgil:changeme@localhost:5432/yetgil

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- External APIs ---
TOUR_API_KEY=
# 한국관광공사 "관광사진 정보" API(data.go.kr에 국문 관광정보와 별도로 등록/
# 활용신청). 비어 있으면 TOUR_API_KEY로 대체한다 — 대부분 같은 계정 키가 두
# API 모두에 쓰인다. data.go.kr 계정이 이 API만 별도 키를 요구하면 채운다.
TOUR_PHOTO_API_KEY=
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=
# 네이버 로그인 전용 client_id/secret — 위 NAVER_NEWS_*(뉴스 검색 API)와는 완전히
# 별개의 애플리케이션이라 네이버 개발자센터에서 따로 발급받는다. 백엔드는 이미
# 구현돼 있지만, 현재 프론트는 AppConstants.showNaverLogin 플래그로 화면에서
# 숨겨둔 상태다(카카오만 노출).
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=
KAKAO_MAP_JS_KEY=
KAKAO_REST_API_KEY=
# console.cloud.google.com → API 및 서비스 → Places API 활성화 후 발급.
# TourAPI(대표사진+관광사진 API) 둘 다에도 사진이 없는 장소(특히 소규모
# 식당·카페)의 마지막 보강 소스 — 비어 있으면 이 보강만 조용히 건너뛴다.
GOOGLE_MAPS_API_KEY=
# openweathermap.org에서 발급 — 코스 지역 날씨 정보. 비어 있으면 날씨 없이 응답.
OPENWEATHER_API_KEY=
# 업로드 사진(프로필/게시글/커스텀 코스) 저장 버킷 이름. 비어 있으면 로컬 개발
# 편의를 위해 컨테이너 로컬 디스크에 저장한다 — 배포 환경(Cloud Run)은 인스턴스가
# 재시작되면 로컬 디스크가 사라지므로 반드시 채워야 한다.
GCS_BUCKET_NAME=

# --- 자체 회원가입 휴대폰 인증 (네이버클라우드 SENS) ---
# 콘솔: console.ncloud.com → Simple & Easy Notification Service > SMS.
# 인증키(NCP_ACCESS_KEY/NCP_SECRET_KEY)는 마이페이지 > 계정관리 > 인증키 관리에서 발급.
# 발신번호(NCP_SENS_SENDER_NUMBER)는 SENS 프로젝트에서 사전 등록(본인 명의 휴대폰
# 인증)이 필요하고, 하이픈 없이 숫자만(예: 01012345678) 넣는다.
# 넷 중 하나라도 비어 있으면 발송 실패(503)로 처리한다. 자체 회원가입은 항상
# 휴대폰 인증이 필수이므로 승인된 발신번호를 포함한 발송 설정이 필요하다.
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
NCP_SENS_SERVICE_ID=
NCP_SENS_SENDER_NUMBER=

# --- LLM (코스 추천 생성, 맛집 추천) ---
# console.anthropic.com에서 발급 (claude.ai Pro 구독과는 별개의 계정/과금).
ANTHROPIC_API_KEY=

# --- LLM (챗봇 "훈장님") ---
# Google Gemini API 키. Vertex AI Express Mode 키인 경우 일반 AI Studio
# 엔드포인트가 아니라 Vertex AI 전용 엔드포인트로 호출해야 한다
# (backend/app/services/chatbot.py 참고).
GEMINI_API_KEY=

# --- Auth (JWT) ---
# 반드시 아래 명령으로 생성한 값으로 교체할 것: openssl rand -hex 32
# 배포 환경에서 기본값 그대로 두면 서버가 기동을 거부한다.
JWT_SECRET_KEY=

# --- ML Serving ---
# 아직 실제로 쓰이지 않는다 — SentimentClient는 현재 텍스트 길이 기반 더미 점수를
# 반환하는 placeholder이고, 이 경로의 실제 ONNX 추론 연결은 TODO로 남아 있다.
SENTIMENT_MODEL_PATH=./ml/serving/model.onnx
