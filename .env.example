# --- App ---
ENV=development
DEBUG=true

# --- Database ---
POSTGRES_USER=yetgil
POSTGRES_PASSWORD=changeme
POSTGRES_DB=yetgil
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://yetgil:changeme@localhost:5432/yetgil

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- External APIs ---
TOUR_API_KEY=
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=
KAKAO_MAP_JS_KEY=
KAKAO_REST_API_KEY=

# --- LLM (코스 추천 생성) ---
# console.anthropic.com에서 발급 (claude.ai Pro 구독과는 별개의 계정/과금).
ANTHROPIC_API_KEY=

# --- Auth (JWT) ---
# 반드시 아래 명령으로 생성한 값으로 교체할 것: openssl rand -hex 32
# 배포 환경에서 기본값 그대로 두면 서버가 기동을 거부한다.
JWT_SECRET_KEY=

# --- ML Serving ---
SENTIMENT_MODEL_PATH=./ml/serving/model.onnx
