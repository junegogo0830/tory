# --- App ---
ENV=development
DEBUG=true

# --- Database ---
POSTGRES_USER=yetgil
POSTGRES_PASSWORD=changeme
POSTGRES_DB=yetgil
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://yetgil:changeme@localhost:5432/yetgil

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- External APIs ---
TOUR_API_KEY=
# 한국관광공사 "관광사진 정보" API(data.go.kr에 국문 관광정보와 별도로 등록/
# 활용신청). 비어 있으면 TOUR_API_KEY로 대체한다 — 대부분 같은 계정 키가 두
# API 모두에 쓰인다. data.go.kr 계정이 이 API만 별도 키를 요구하면 채운다.
TOUR_PHOTO_API_KEY=
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=
KAKAO_MAP_JS_KEY=
KAKAO_REST_API_KEY=
# console.cloud.google.com → API 및 서비스 → Places API 활성화 후 발급.
# TourAPI(대표사진+관광사진 API) 둘 다에도 사진이 없는 장소(특히 소규모
# 식당·카페)의 마지막 보강 소스 — 비어 있으면 이 보강만 조용히 건너뛴다.
GOOGLE_MAPS_API_KEY=

# --- 자체 회원가입 휴대폰 인증 (네이버클라우드 SENS) ---
# 콘솔: console.ncloud.com → Simple & Easy Notification Service > SMS.
# 인증키(NCP_ACCESS_KEY/NCP_SECRET_KEY)는 마이페이지 > 계정관리 > 인증키 관리에서 발급.
# 발신번호(NCP_SENS_SENDER_NUMBER)는 SENS 프로젝트에서 사전 등록(본인 명의 휴대폰
# 인증)이 필요하고, 하이픈 없이 숫자만(예: 01012345678) 넣는다.
# 넷 중 하나라도 비어 있으면 발송 실패(503)로 처리한다. 자체 회원가입은 항상
# 휴대폰 인증이 필수이므로 승인된 발신번호를 포함한 발송 설정이 필요하다.
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
NCP_SENS_SERVICE_ID=
NCP_SENS_SENDER_NUMBER=

# --- LLM (코스 추천 생성) ---
# console.anthropic.com에서 발급 (claude.ai Pro 구독과는 별개의 계정/과금).
ANTHROPIC_API_KEY=

# --- Auth (JWT) ---
# 반드시 아래 명령으로 생성한 값으로 교체할 것: openssl rand -hex 32
# 배포 환경에서 기본값 그대로 두면 서버가 기동을 거부한다.
JWT_SECRET_KEY=

# --- ML Serving ---
SENTIMENT_MODEL_PATH=./ml/serving/model.onnx
