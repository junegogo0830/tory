# --- Python / FastAPI ---
# tory-frontend-mock-ui/에도 참고용 backend/ 사본이 있어 top-level 앵커 대신
# 어디서든 매칭되게 한다 (컴파일 캐시는 어느 디렉터리에 있어도 커밋 대상이 아님).
**/__pycache__/
**/*.pyc
**/*.pyo
backend/.venv/
backend/venv/
backend/.pytest_cache/
backend/*.egg-info/
backend/.mypy_cache/
backend/.ruff_cache/
backend/uploads/

# --- ML ---
ml/data/*
!ml/data/.gitkeep
ml/**/__pycache__/
ml/.venv/
ml/**/*.onnx
ml/**/checkpoints/

# --- Infra / DB volumes ---
infra/pgdata/
infra/redisdata/

